NotEnabled: Нужно включить эту функцию в конфигурации мода

SuperVault: {
	DisplayName: Большой рюкзак
	Description: Открывает рюкзак на 100 ячеек инвентаря
}

PlayerStats: {
	DisplayName: Характеристики игрока
	Description: Показывает различные характеристики игрока
}

Spectating: {
	DisplayName: Наблюдение
	Description: Позволяет наблюдать за своими сокомандниками во время битв с боссами
}

WeatherControl: {
	DisplayName: "{$Mods.ImproveGame.UI.WeatherGUI.Title}"
	Description: Открывает меню для изменения времени, фазы луны, направления ветра и дождя
}

ItemSearcher: {
	DisplayName: "{$Mods.ImproveGame.UI.ItemSearcher.Title}"
	Description: Помогает найти предметы в личных хранилищах и ближайших сундуках
}

BagOpener: {
	Description: Открывает меню для массового открытия мешков
	DisplayName: "{$Mods.ImproveGame.UI.OpenBag.Title}"
}

WorldFeature: {
	Description: Активация праздников или функций секретных зёрен
	DisplayName: "{$Mods.ImproveGame.UI.WorldFeature.Title}"
}

PotionBag: {
	Description: Открывает первую сумку для зелий в вашем инвентаре
	DisplayName: "{$Mods.ImproveGame.Items.PotionBag.DisplayName}"
}

BannerChest: {
	Description: Открывает первую коробку со знамёнами в вашем инвентаре
	DisplayName: "{$Mods.ImproveGame.Items.BannerChest.DisplayName}"
}

ModConfig: {
	DisplayName: Конфигурации мода
	Description: Быстрый доступ к избранным конфигурациям
}

AmmoChain: {
	DisplayName: Цепочка боеприпасов
	Description: Позволяет оружиям использовать боеприпасы в определённой последовательности
}

QuickShimmer: {
	DisplayName: Быстрое мерцание
	Description: Трансмутации вне эфира!
