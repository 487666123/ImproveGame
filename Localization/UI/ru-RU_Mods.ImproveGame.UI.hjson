WeatherGUI: {
	Title: Управление погодой
	Wind: <left>, чтобы изменить направление ветра
	WindLockFalse: <right>, чтобы закрепить направление ветра
	WindLockTrue: <right>, чтобы открепить направление ветра
	WindWest: Изменено на сильный западный ветер
	WindNo: Изменено на ветер по умолчанию
	WindEast: Изменено на сильный восточный ветер
	WindLocked: Скорость и направление ветра закреплены
	WindUnlocked: Скорость и направление ветра откреплены
	RainActive: <left>, чтобы начать дождь
	RainInactive: <left>, чтобы закончить дождь
	RainLockFalse: <right>, чтобы закрепить состояние дождя
	RainLockTrue: <right>, чтобы открепить состояние дождя
	RainOn: Дождь начался
	RainOff: Дождь закончился
	RainLocked: Изменения дождя приостановлены
	RainUnlocked: Изменения дождя возобновлены
	SandstormActive: 左键点击以开始沙尘暴
	SandstormInactive: 左键点击以停止沙尘暴
	SandstormLockFalse: 右键点击以锁定沙尘暴状态
	SandstormLockTrue: 右键点击以解锁沙尘暴状态
	SandstormOn: 已开始沙尘暴
	SandstormOff: 已停止沙尘暴
	SandstormLocked: 沙尘暴状态已锁定
	SandstormUnlocked: 沙尘暴状态已解锁
	Time: <left>, чтобы изменить время
	Dawn: Время изменено на рассвет
	Noon: Время изменено на полдень
	Dusk: Время изменено на закат
	Midnight: Время изменено на полночь
	MoonPhase: <left>, чтобы изменить фазу луны
	MoonPhaseLockFalse: <right>, чтобы закрепить изменения фазы луны
	MoonPhaseLockTrue: <right>, чтобы открепить изменения фазы луны
	MoonPhaseAdjusted: Фаза изменена на: {0}
	MoonPhaseLocked: Фаза луны закреплена на: {0}
	MoonPhaseUnlocked: Фаза луны откреплена
	AlreadyUnlocked: Управление погодой уже открыто в этом мире
	Unlocked: Управление погодой открыто! Доступно в панели управления
	EasterEgg: Гриб!
	Locked: Используйте [i:ImproveGame/WeatherBook], чтобы открыть управление погодой
	TimeUnlockCondition: Убейте Стену плоти, чтобы менять время
}

PlayerStats: {
	# 翻译提示: 尽量简短，因为UI的空间有限，不要超过10个字符
	Introduction:
		'''
		[c/CC88AA:Панель характеристик]
		<left> по категории или характеристике, чтобы закрепить её
		Удерживайте правую кнопку мыши, чтобы перетащить кнопку
		'''
	Control: Панель характеристик
	Name: Характеристики игрока
	Melee: Воин
	Ranged: Стрелок
	Magic: Маг
	Summon: Призыватель
	Throwing: Метатель
	# 其他玩家属性
	Other: Другие
	LifeRegen: Регенерация
	ArmorPenetration: Проб. брони
	# 魔力恢复，因为归在大类“魔法”下所以用Regen代替
	Regen: Восст. маны
	# 魔力消耗，因为归在大类“魔法”下所以用Cost代替
	Cost: Трата маны
	MaxMinions: Миньоны
	MaxTurrets: Стражники
	Endurance: Сопр. урону
	Luck: Удача
	Aggro: Агро
	BulletDamage: Урон пуль
	ArrowDamage: Урон стрел
	SpecialistDamage: Особый урон
	Damage: Урон
	Crit: Крит. шанс
	# 攻击速度
	Speed: Скор. атаки
	SummonMeleeSpeed: Скор. хлыстов

	CalamityMod: {
		Rogue: Разбойник
		# 盗贼弹幕速度，英文原文“Rogue Velocity”，这里归在大类“Rogue”下所以用Velocity代替
		RogueVelocity: Скор. снарядов
	}

	ThoriumMod: {
		Healer: Лекарь
		# 牧师治疗工具（法术）的攻击速度，英文原文即“Healing Speed”，由于UI空间有限去掉了"ing"
		HealingSpeed: Скор. лечения
		# 瑟银的一些牧师装备增加法术回血量
		HealBonus: Бонус лечения
		Bard: Бард
	}
}

ExtremeStorage: {
	QuickSearch: Нажмите {0}, чтобы искать выбранный предмет
	AddChest: Добавить сундук
	AddChestTip: Нажмите ПКМ, чтобы отменить
	RejectNearbyStack: Не удалось сложить предметы в сундуки. Возможно, другие игроки сейчас используют Storage Manager
	CloseCraftingWindow: Закрыть окно создания
	OpenCraftingWindow: Открыть окно создания

	CountForCrafting: {
		Label: Использовать при создании
		Tooltip:
			'''
			Определяет, могут ли предметы данной категории [c/CC88AA:быть использованы при создании]
			Вы всё ещё можете использовать предметы, если откроете сундук вручную
			Слишком много предметов в одной категории могут вызвать проблемы с производительностью
			'''
	}

	UseUnlimitedPotion: {
		Label: Бесконечные зелья
		Tooltip:
			'''
			Определяет, будут ли зелья и станции-усилители в категории [c/CC88AA:«{$Mods.ImproveGame.UI.ExtremeStorage.ItemGroup.Alchemy}»] давать [c/CC88AA:бесконечные эффекты]
			Чтобы это работало, нужно будет включить настройку «Бесконечные зелья»
			'''
	}

	UsePortableStation: {
		Label: Переносные станции создания
		Tooltip:
			'''
			Определяет, будут ли станции создания в категории [c/CC88AA:«{$Mods.ImproveGame.UI.ExtremeStorage.ItemGroup.Furniture}»] использоваться как [c/CC88AA:переносные станции создания]
			Чтобы это работало, нужно будет включить настройку «Переносные станции создания»
			'''
	}

	UsePortableBanner: {
		Label: Переносные знамёна
		Tooltip:
			'''
			Определяет, будут ли знамёна в категории [c/CC88AA:«{$Mods.ImproveGame.UI.ExtremeStorage.ItemGroup.Furniture}»] использоваться как [c/CC88AA:переносные знамёна]
			Чтобы это работало, нужно будет включить настройку «Переносные знамёна»
			'''
	}

	ChestBeingUsed: Сундук с этим предметов сейчас используется другим игроком
	# 介绍使用了手动换行让排版看起来舒服点
	BasicIntroduction:
		'''
		Заметки:
		  1. Сортировка сундуков работает на системе
			 идентификаторов в названии сундука. Пожалуйста,
			 не меняйте название сундука после того, как вы
			 добавили его в систему
		  2. Помещайте сундуки с зельями и мебелью в
			 соответствующие категории, всё остальное помещайте
			 в категорию «Всё»
		  3. В мультиплеере, если сундук используется другим
			 игроком, вы никак не сможете взаимодействовать с
			 предметами из этого сундука
		'''

	ItemGroup: {
		Weapon: "{$CreativePowers.TabWeapons}"
		Tool: "{$CreativePowers.TabTools}"
		Ammo: "{$LegacyInterface.27}"
		Armor: "{$CreativePowers.TabArmor}"
		Accessory: "{$CreativePowers.TabAccessories}"
		Furniture: "{$CreativePowers.TabFurniture}"
		Block: Блоки
		Material: "{$CreativePowers.TabMaterials}"
		Alchemy: Зелья
		Misc: "{$CreativePowers.TabMisc}"
		Setting: "{$LegacyMenu.14}"
		Everything: Всё
	}

	# 筛选器的文本
	Weapon: {
		Melee: Ближнее
		Ranged: Дальнее
		Magic: Магическое
		Summon: Призывательное
		Other: Другие
	}

	Tool: {
