	DisplayName: Дрон-исследователь
}

DevMark: {
	DisplayName: Метка разработчика
	Tooltip:
		'''
		[c/ff0000:Предмет разработчика]
		Пока она находится в инвентаре, жезл строительства не будет тратить материалы (Работает только в одиночной игре)
		Открытие рыболовной машины автоматически заполняет её предметами для рыбалки
		Можно поместить в ячейку для аксессуара рыболовной машины, что значительно увеличит скорость её рыбалки
		'''
}

Expelliarmus: {
	DisplayName: Экспеллиармус!
	Tooltip:
		'''
		[c/ff0000:Предмет отладки]
		Заставляет существ выронить их предметы
		Может быть использован для проверки выпадаемых предметов у существ
		'''
}

ShimmerTech: {
	DisplayName: Измерцатель
	Tooltip:
		'''
		[c/ff0000:Предмет отладки]
		Убирает бонусы от предметов мерцания у вашего игрока
		<right> убирает бонусы от предметов мерцания у всего мира
		{$ItemName.AegisCrystal}
		{$ItemName.ArcaneCrystal}
		{$ItemName.AegisFruit}
		{$ItemName.Ambrosia}
		{$ItemName.GummyWorm}
		{$ItemName.GalaxyPearl}
		{$ItemName.CombatBookVolumeTwo}
		{$ItemName.PeddlersSatchel}
		«Вжух!»
		'''
}

Dummy: {
	DisplayName: Пугало-мишень
	Tooltip:
		'''
		Может быть использовано для проверки урона в секунду
		ЛКМ создаёт пугало-мишень на месте вашего курсора
		ПКМ убирает пугало, на которое наведён курсор
		Alt + ПКМ убирает все пугала в мире
		Доступные команды (исп. в чате):
		 /dummy info → просмотреть хар-ки пугала
		 /help dummy → информация об использовании пугала
		«Не бей меня :)»
		'''
	ConfigUIOpenTip: Нажмите {0} пока вы держите предмет, чтобы вывести панель управления
	NoneKeyBind: <Не назначена>
	CannotUse: На данный момент этот предмет не работает в сетевой игре.
}

StorageCommunicator: {
	DisplayName: Коммутатор хранилища
	Tooltip:
		'''
		Позволяет дистанционно взаимодействовать с панелью управления хранилищем
		Нажмите <right> по любой панели управления хранилищем, чтобы подключить её
		Используйте предмет, чтобы открыть подключить панель управления
		'''
	NotSet: На данный момент не подключена ни к чему
	SetTo: Подключена к панели управления хранилищем на [{0}, {1}]
	MissingStorage: Панель управления хранилищем не найдена
	Unlocated: Не подключена к панели управления хранилищем, используйте <right> на панели управления, пока держите этот предмет, чтобы подключить её
}

