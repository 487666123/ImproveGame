	ShowMoreData: {
		Label: "[centeritem:1344] Показывать дебаг-данные"
		Tooltip:
			'''
			Настройка разработчиков, не предназначена для обычных игроков
			Если настройка включена, будут выводиться различные дебаг-данные
			'''
	}

	ShowModName: {
		Label: "[centeritem:ImproveGame/LiquidWand] Показывать, из какого мода предметы"
		Tooltip: ""
	}

	PlyInfo: {
		Label: "[centeritem:3124] Характеристики игрока"
		Tooltip: Рядом с иконкой достижений появляется четырёхлистный клевер
	}

	QoLAutoTrash: {
		Label: "[centeritem:348] Авто-выбрасывание"
		Tooltip:
			'''
			Автоматическая ячейка для мусора
			Предметы автоматически будут перемещаться в корзину, если их тип уже есть внутри
			Сохраняет до 6 последних выброшенных предметов
			Shift+Ctrl+<left> по предмету, чтобы переместить его в корзину
			'''
	}

	FontOffsetPreviewText: Откалибруйте отступ, чтобы текст помещался на линии
	BigFontOffsetPreviewText: Съешь ещё этих...

	OpenConfig: {
		Label: "{$Mods.ImproveGame.Configs.ImproveConfigs.OpenConfig.Label}"
		Tooltip: "{$Mods.ImproveGame.Configs.ImproveConfigs.OpenConfig.Tooltip}"
	}

	KeepFocus: {
		Label: "[centeritem:TVHeadMask] Игра работает даже в фоновом режиме"
		Tooltip:
			'''
			Даже пока игра не является активным окном (т.е. находится в фоне),
			она всё ещё продолжает работать, а не ставится на паузу
			'''
	}

	ExplosionEffect: {
