ImproveConfigs: {
	DisplayName: 1. Основная конфигурация

	ILoveBalance: {
		Label: Я ОБОЖАЮ баланс
		Tooltip:
			'''
			Если вы хотите, чтобы ваши прохождения были близки к ванильной Terraria, то данный пресет — ваш наилучший выбор
			С этим пресетом ваши хффекты просто не будут пропадать после смерти вместо того, чтобы действовать вечно
			Большинство функций скорректированы до относительно сбалансированного уровня,
			чтобы достичь упрощённого, но всё ещё похожего на ванильный геймплея
			(Используйте предметы данного мода на своё усмотрение, т.к. некоторые из них могут быть несбалансированными)
			(Вы можете вносить изменения после выбора пресета)
			'''
	}

	FukMeCalamity: {
		Label: Эти моды просто имба!
		Tooltip:
			'''
			Данный пресет включает в себя самые удобные настройки, которые значительно уменьшают гринд
			Если вы играете в Calamity в режиме Возмездие или Fargo's Souls в режиме Вечность, этот пресет подойдёт лучше всего
			Большинство настроек упрощают геймплей, направляя фокус на продвижение и битвы с боссами
			(Вы можете вносить изменения после выбора пресета)
			'''
	}

	SuperVault: {
		Label: "[centeritem:3813] Большой рюкзак"
		Tooltip:
			'''
			Отдельный инвентарь на 100 ячеек, которые также можно использовать в создании
			Есть функции авто-подбора и умного подбора предметов
			Пожалуйста, назначьте клавишу: Настройки → Управление → пролистните вниз и найдите «Большой рюкзак»
			'''
	}

	SuperVoidVault: {
		Label: "[centeritem:4131] Авто-подбор предметов для личных хранилищ"
		Tooltip:
			'''
			Позволяет другим личным хранилищам автоматически складывать собираемые предметы, когда ваш инвентарь полон
			Приоритет: Свинья-копилка → Сейф → Печь защитника → Сейф пустоты
			'''
	}

	SmartVoidVault: {
		Label: "[centeritem:4076] Умный подбор предметов для личных хранилищ"
		Tooltip: Если в вашем сейфе пустоты уже есть предметы, эти предметы будут автоматически переноситься внутрь него
	}

	ItemMaxStack: {
		Label: "[centeritem:9] Максимальный стак"
		Tooltip:
			'''
			Ставит максимальный размер стаков для предметов
			Максимальный размер стака для монет не изменяется
			'''
	}

	GrabDistance: {
		Label: "[centeritem:5010] Увеличить дистанцию подбора предметов (изм. в блоках)"
		Tooltip: Увеличивает дистанцию подбора предметов. Скорость подбора также увеличивается
	}

	NoConsume_SummonItem: {
		Label: "[centeritem:560] Нерасходуемые предметы призыва"
		Tooltip: Только для предметов призыва ванильных боссов и событий
	}

	ModifyPlayerPlaceSpeed: {
		Label: "[centeritem:2214] Увеличить скорость размещения блоков"
		Tooltip: ""
	}

	ModifyPlayerTileRange: {
		Label: "[centeritem:2215] Увеличить дальность размещения блоков"
		Tooltip: ""
	}

	TileSpeed_Blacklist: {
		Label: "[centeritem:1448] Чёрный список для улучшений размещения блоков"
		Tooltip:
			'''
			Скорость и дальность размещения не будет увеличиваться для блоков,
			если их название или часть названия включено в данный список
			Не чувствителен к регистру символов
			'''
	}

	PortableCraftingStation: {
		Label: "[centeritem:WorkBench] Переносные станции создания"
		Tooltip:
			'''
			Станции создания в инвентаре и личных хранилищах будут функционировать так, будто они поставлены
			Например, если в вашем инвентаре есть печь, вы сможете переплавить руду в слитки в любой момент
			Вёдра воды, лавы и мёда считаются источниками их соответствующих жидкостей
			'''
	}

	NoPlace_BUFFTile: {
		Label: "[centeritem:3198] Переносные станции-усилители"
		Tooltip: Ванильные станции-усилители (напр. точильный камень) в любом из ваших инвентарей будут давать свои эффекты
	}

	NoPlace_BUFFTile_Banner: {
		Label: "[centeritem:2901] Переносные знамёна"
		Tooltip: Знамёна любых врагов в любом из ваших инвентарей будут давать свои бонусы
	}

	NoConsume_Potion: {
		Label: "[centeritem:227] Бесконечные зелья"
		Tooltip:
			'''
			Зелья в вашем инвентаре или личных хранилища (свинья-копилка, сейф и т.д.)
			в стаке определённого размера или более больше не тратятся и дают свои эффекты
			Установите требуемое число в следующей настройке
			'''
	}

	NoConsume_PotionRequirement: {
		Label: "[centeritem:TeleportationPotion] Требования для бесконечных зелий"
		Tooltip:
			'''
			Только стаки зелий этого размера или более будут давать свои эффекты
			Пределы: от 10 до 999
			'''
	}

	NoConsume_Ammo: {
		Label: "[centeritem:3104] Бесконечные боеприпасы"
		Tooltip: Боеприпасы в стаке 3996 или более не тратятся
	}

	NoConsume_Projectile: {
		Label: "[centeritem:42] Бесконечные метательные оружия"
		Tooltip: Метательные оружия в стаке 3996 или более не тратятся
	}

	NoConsume_Wire: {
		Label: "[centeritem:530] Бесконечные провода"
		Tooltip: Провода в стаке 3996 или более не тратится
	}

	ImprovePrefix: {
		Label: "[centeritem:1551] Перековка с эффектом памяти"
		Tooltip: Префиксы, которые уже были получены, можно добавить вручную
		Unknown: Неизвестный префикс
	}

	ResurrectionTimeShortened: {
		Label: "[centeritem:3232] Ускоренное возрождение"
		Tooltip: Значение 25 соответствует уменьшению времени возрождения на 25%
	}

	BOSSBattleResurrectionTimeShortened: {
		Label: "[centeritem:3232] Ускоренное возрождение при битве с боссом"
		Tooltip: ""
	}

	MiddleEnableBank: {
		Label: "[centeritem:87] Открытие личных хранилищ колёсиком мыши"
		Tooltip:
			'''
			Когда вы нажимаете колёсиком по предмету личного хранилища в инвентаре,
			соответствующее хранилище открывается
			Также отключает лимит по расстоянию открытия личных хранилищ
			'''
	}

	BanTombstone: {
		Label: "[centeritem:3230] Отключить надгробия"
		Tooltip: ""
	}

	FasterExtractinator: {
		Label: "[centeritem:ChlorophyteExtractinator] Ускоренная переработка"
		Tooltip: Значительно увеличивает скорость работы перерабатывателя
	}

	TownNPCGetTFIntoHouse: {
		Label: "[centeritem:MusicBoxTownDay] Улучшение механик появления поселенцев"
		Tooltip:
			'''
			Когда соблюдены все требования для появления гоблина-изобретателя, трактирщика, волшебника, механика или сборщика налогов,
			их не нужно будет спасать, и они сами появятся, если есть пустые дома. Они будут считаться спасёнными после первого появления
			Стилист может появиться после победы над любым ванильным боссом до сложного режима
			Поселенцы могут появляться ночью
			'''
	}

	NPCLiveInEvil: {
		Label: "[centeritem:MusicBoxTownNight] Поселенцы могут жить в биомах мирового зла"
		Tooltip: Поселенцы могут жить в порче и/или багрянце
	}

	TownNPCSpawnSpeed: {
		Label: "[centeritem:4910] Множитель скорости появления поселенцев"
		Tooltip: Выставьте значение на 1, чтобы отключить данную настройку
	}

	NoCD_FishermanQuest: {
		Label: "[centeritem:4608] Мгновенное обновление заданий рыбака"
		Tooltip: Мгновенно обновляет задания рыбака, когда вы даёте ему нужную рыбу. Вы также можете настроить, чтобы рыба не менялась
	}

	NPCCoinDropRate: {
		Label: "[centeritem:73] Множитель выпадающих из врагов монет"
		Tooltip: ""
	}

	SlimeExDrop: {
		Label: "[centeritem:11] Гарантированные предметы из слизней"
		Tooltip:
			'''
			Из слизней теперь гарантированно выпадает случайный предмет, находящийся внутри их
			Следует ванильным шансам выпадения, если настройка выключена
			'''
	}

	LavalessLavaSlime: {
		Label: "[centeritem:LavaSlimeBanner] Лавовые слизни/адские летучие мыши без лавы"
		Tooltip:
			'''
			Убитые лавовые слизни больше не создают лаву в режиме эксперта или выше
			Также работает для адских летучих мышей в мирах «Get fixed boi»
			'''
	}

	TravellingMerchantStay: {
		Label: "[centeritem:2222] Странствующий торговец не уходит"
		Tooltip: Странствующий торговец не уйдёт из мира, пока он не будет убит
	}

	TravellingMerchantRefresh: {
		Label: "[centeritem:PeddlersSatchel] Обновляемый магазин странствующего торговца"
		Tooltip: Добавляет странствующему торговку кнопку «Обновить», что позволяет обновить его ассортимент
	}

	QuickNurse: {
		Label: "[centeritem:AdhesiveBandage] Первая помощь"
		Tooltip:
			'''
			Медсестра лечит вас сразу, когда вы нажимаете правой кнопкой мыши по ней
			Цена будет указана над игроком
			'''
	}

	BestiaryQuickUnlock: {
		Label: "[centeritem:DontHurtCrittersBook] Экспресс-курс"
		Tooltip: Бестиарий любого существа будет открыт сразу после первого убийства/взаимодействия
	}

	BannerRequirement: {
		Label: "[centeritem:2990] Количество убийств для знамени"
		Tooltip:
			'''
			Изменяет кол-во убийств, нужных для получения знамени. Чем меньше число, тем меньше понадобится убийств
			Например, когда выставлен множитель 0,1(10%), понадобится убить 5 синих слизней, чтобы получить знамя
			И наоборот, когда выставлен множитель 10(1000%), понадобится убить 500 синих слизней
			'''
	}

	AlchemyGrassGrowsFaster: {
		Label: "[centeritem:313] Ускоренный рост цветов"
		Tooltip: Ускоряет рост цветов по типу дневноцвета
	}

	AlchemyGrassAlwaysBlooms: {
		Label: "[centeritem:316] Цветы цветут при любых условиях"
		Tooltip: Цветы теперь могут цвести и давать семена в любых условиях
	}

	PumpkinGrowsFaster: {
		Label: "[centeritem:1725] Ускоренный рост тыкв"
		Tooltip: Ускоряет рост тыкв
	}

	LifeFruitGrowsFaster: {
		Label: "[centeritem:1291] Ускоренный рост фруктов жизни"
		Tooltip: Ускоряет рост фруктов жизни
	}

	LifeFruitLimit: {
		Label: "[centeritem:1291] Лимит фруктов жизни"
		Tooltip:
			'''
			Изменяет радиус обнаружения фруктами жизни других фруктов поблизости
			Выставьте значение на -1, чтобы использовать стандартные значения（один каждые 60（классика）/ 50（эксперт）блоков）
			Учтите, что в режиме эксперта и выше будет использоваться заданное значение минус 10
			'''
	}

	StaffOfRegenerationAutomaticPlanting: {
		Label: "[centeritem:213] Посох/топор выращивания автоматически садят семена"
		Tooltip: Автоматически ставит семя собранного цвета при использовании посоха/топора выращивания
	}

	NoBiomeSpread: {
		Label: "[centeritem:Sunflower] Биомы мирового зла и освящение не распространяются"
		Tooltip: ""
	}

	RespawnWithFullHP: {
		Label: "[centeritem:LifeCrystal] Возрождение с полным здоровьем"
		Tooltip: ""
	}

	DontDeleteBuff: {
		Label: "[centeritem:FlaskofNanites] Оставлять эффекты после смерти"
		Tooltip: Эффекты зелий и станций-усилителей остаются при вас после смерти
	}

	JourneyResearch: {
		Label: "[centeritem:GoldBunny] Автоматическое исследование"
		Tooltip:
			'''
			В режиме приключения предметы в необходимом кол-ве и помеченные как избранное будут автоматически исследованы
			Эта функция не расходует предметы
			'''
	}

	BanDamageVar: {
		Label: "[centeritem:6] Отключить разброс урона"
		Tooltip: ""
	}

	ExtraPlayerBuffSlots: {
		Label: "[centeritem:3000] Дополнительные ячейки для эффектов"
		Tooltip: ""
	}

	TreeGrowFaster: {
		Label: "[centeritem:1182] Деревья растут быстрее и игнорируют высоту"
		Tooltip:
			'''
			Увеличивает скорость роста деревьев на 5
			Самоцветные деревья могут расти на поверхности, а обычные — под землёй
			Не влияет на скорость роста деревьев джунглей и огромных светящихся грибов
			'''
	}

	ShakeTreeFruit: {
		Label: "[centeritem:4009] Гарантированное выпадение фруктов при тряске деревьев"
		Tooltip:
			'''
			Значительно увеличивает шанс выпадения фруктов (не влияет на шанс выпадения других предметов)
			Если кажется, будто это функция ничего не делает, обратитесь к вики Terraria и посмотрите условия выпадения
			'''
	}

	GemTreeAlwaysDropGem: {
		Label: "[centeritem:3649] С самоцветных деревьев всегда выпадают самоцветы"
		Tooltip: С каждой части самоцветного дерева выпадают самоцветы и самоцветные жёлуди
	}

	ShareCraftingStation: {
		Label: "[centeritem:WorkBench] Общие переносные станции создания"
		Tooltip:
			'''
			Игроки в одной команде делятся своими эффектами станций создания
			Например, если у другого игрока на вашей команде есть верстак, вы сможете скрафтить стул без верстака
			Для работы этой настройки, пожалуйста, включите «Переносные станции создания»
			Может вызывать лаги при большой количестве игроков (>100)
			'''
	}

	ShareInfBuffs: {
		Label: "[centeritem:227] Общие бесконечные эффекты"
		Tooltip:
			'''
			Игроки в одной команде делятся своими бесконечными эффектами зелий и бонусами знамён
			Например, если у другого игрока на вашей команде есть кусок торта, вы тоже получите «Сахарную лихорадку»
			Для работы этой настройки, пожалуйста, включите любую настройку, связанную с бесконечными эффектами
			Может вызывать лаги при большой количестве игроков (>100)
			'''
	}

	ShareRange: {
		Label: "[centeritem:WorldGlobe] Дальность общих эффектов (в блоках)"
		Tooltip:
			'''
			Только игроки из одной команды в этом радиусе будут получать общие эффекты
			По умолчанию стоит -1, означающее бесконечную дальность
			'''
	}

	TeamAutoJoin: {
		Label: "[centeritem:TeamBlockRed] Автоматически присоединяться к красной команде"
		Tooltip: Только что подключившиеся игроки будут автоматически присоединяться к красной команде в сетевой игре
	}

	OnlyHost: {
		Label: "[centeritem:2203] Только хост может менять настройки мода (не работает при присоединении к порту)"
		Tooltip:
			'''
			Не делает ничего в одиночной игре
			Если включена, только хост (IP: 127.0.0.1) может изменять настройки мода
			Только хост может включить/выключить эту настройку
			Если сервер работает на присоединении к порту, пожалуйста, используйте настройку ниже
			'''
		Unaccepted: Нельзя сохранить: Вы не хост!
		Tips:
			'''
			Включена настройка «Только хост может менять настройки мода»
			Только хост (IP: 127.0.0.1) может изменять настройки мода
			'''
	}

	OnlyHostByPassword: {
		Label: "[centeritem:2203] Только подтверждённые игроки могут менять настройки мода"
		Tooltip:
			'''
			Не делает ничего в одиночной игре, требует перезагрузку. Если включена, только подтвержденныу игроки могут изменять настройки мода
			При запуске сервера, в консоль сервера будет отправлен случайный пароль из 8 знаков. Можно запросить пароль в консоли с помощью команды qotpassword
			Игроки могут ввести /qotpassword <пароль>, чтобы стать подтверждёнными. Если пароль верный, игрок сможет изменять настройки
			Эффективна на серверах с присоединением к порту, т.к. на них верификация по IP не работает
			'''
		Unaccepted: Вы не прошли подтверждение!
		Tips: Включена настройка «Только подтвержденные игроки могут менять настройки мода».
		Registered: Вы уже можете изменять настройки.
		Correct: Пароль верный, вы можете изменять настройки.
		Incorrect: Неверный пароль!
		ServerPassword: "[Quality of Terraria] Пароль для подтверждения: {Password}."
		ServerPasswordLog: Пароль для подтверждения: {Password}.
		CommandDescription: Чтобы подтвердить себя, спросите разрешения менять настройки мода.
		NotOn: Настройка подтверждения пароля не включена.
		Format: Пароль должен содержать хотя бы 4 знака (не чувствителен к регистру).
	}

	SpawnRateMaxValue: {
		Label: "[centeritem:2649] Множитель максимальной скорости появления врагов"
		Tooltip:
			'''
			Позволяет игрокам изменять максимальную скорость появления врагов
			Внимание:
			Данная панель появляется только при условии, если у вас есть бесконечные эффекты:
			[Подсолнух][Свеча спокойствия][Успокаивающее зелье][Водяная свеча] и [Зелье битвы]
			Если вы не хотите, чтобы игроки на сервере повышали скорость появления врагов до небес, эта настройка поможет поставить лимит
			'''
	}

	SpawnRateMinValue: {
		Label: "[centeritem:2649] Множитель минимальной скорости появления врагов"
		Tooltip:
			'''
			Позволяет игрокам изменять минимальную скорость появления врагов
			Внимание:
			Данная панель появляется только при условии, если у вас есть бесконечные эффекты:
			[Подсолнух][Свеча спокойствия][Успокаивающее зелье][Водяная свеча] и [Зелье битвы]
			Если вы не хотите, чтобы игроки на сервере занижали скорость появления врагов ниже плинтуса, эта настройка поможет поставить лимит
			'''
	}

	ExStorageSearchDistance: {
		Label: "[centeritem:ImproveGame/ExtremeStorage] Дальность обнаружения сундуков панелью управления хранилищем"
		Tooltip:
			'''
			Изменяет, насколько далеко панель управления хранилищем может искать сундуки
			В сетевой игре, чем больше сундуков используется панелью, тем выше нагрузка на сеть
			'''
	}

	ICanSeeForeverAllBag: {
		Label: "[centeritem:GoodieBag] Детали мешков показывают скрытые выпадающие предметы"
		Tooltip:
			'''
			Пока выключена, код выпадения предметов определяет, что скрывать
			Пока включена, скрытые правила всегда показываются
			'''
	}

	LoadModItems: {
		Label: Конфигуграции загрузки предметов мода
		Tooltip: Отключает код некоторых предметов из мода, чтобы они не появлялись в игре
	}

	EmptyAutofisher: {
		Label: "[centeritem:ImproveGame/Autofisher] Предупреждения о нехватке наживки"
		Tooltip:
			'''
			Если в рыболовной машине кончится наживка, в чате появится сообщение: 
			«У рыболовной машины на [горизонтальная позиция, глубина] кончилась наживка»
			'''
	}

	OtherFunctions: {
		Label: Неизменяемые функции
		ExpandTip: Нажмите, чтобы раскрыть
		Subtitle: Данные функции мода не изменяются настройками
		Tooltip:
			'''
			Нажатие клавиши «Предметы в мешке» детально показывает выпадаемые из мешка предметы
			Горячая клавиша для смены панели быстрого доступа на второй ряд инвентаря
			Панель фильтрования, которая открывается при нажатии на иконку анализатора форм жизни
			Проверка предметов в сундуке при наведении курсора и нажатии Alt
			Упрощение описаний (убрано описание избранных предметов, детальное описание в ячейках для украшений)
			Увеличивает скорость и включает авто-использование для кристаллов жизни, кристаллов маны и фруктов жизни
			Нажатие колёсиком по предметам наездных питомцев садит вас на питомца
			Все виды причёски доступны при создании персонажа
			Горячая клавиша жезла телепортации. Использует жезл раздора или жезл гармонии из любого инвентаря, приоритет на жезле гармонии
			Горячая клавиша телепортации домой. Использует любой бесконечный возвращающий домой предмет из любого инвентаря, приоритет на [centeritem:4870] зелье возвращения
			Можно использовать боеприпасы из большого рюкзака
			'''
	}

	ExtraToolSpeed: {
		Label: "[centeritem:4056] Множитель скорости инструментов"
		Tooltip: Выставьте значение на 0, чтобы отключить. Чем выше значение, тем больше скорость. Не влияет на скорость атаки и урон
	}

	MostTreeMin: {
		Label: "[centeritem:9] Минимальная высота обычных деревьев"
		Tooltip: По умолчанию — 7
	}

	MostTreeMax: {
		Label: "[centeritem:9] Максимальная высота обычных деревьев"
		Tooltip: По умолчанию — 12
	}

	PalmTreeMin: {
		Label: "[centeritem:2504] Минимальная высота пальм"
		Tooltip: По умолчанию — 10
	}

	PalmTreeMax: {
		Label: "[centeritem:2504] Максимальная высота пальм"
		Tooltip: По умолчанию — 20
	}

	GemTreeMin: {
		Label: "[centeritem:4856] Минимальная высота самоцветных деревьев"
		Tooltip: По умолчанию — 7
	}

	GemTreeMax: {
		Label: "[centeritem:4856] Максимальная высота самоцветных деревьев"
		Tooltip: По умолчанию — 12
	}

	Headers: {
		Item: "[centeritem/h4:LifeCrystal] Настройки предметов"
		NPC: "[centeritem:4382] Настройки поселенцев"
		GameMechanics: "[centeritem:1344] Игровые механики"
		Tree: "[centeritem/h4:27] Настройки деревьев"
		Together: "[centeritem/h2:GolfCupFlagRed] Вместе весело шагать..."
		Server: "[centeritem:ImproveGame/CreateWand] Настройки мода"
		Presets: "[centeritem:ImproveGame/PaintWand] Пресеты"
		Others: "[centeritem/h4:HandOfCreation] Другое"
		ItemEffect: "[centeritem/h4:RedPotion] Эффекты предметов"
		PylonMechanics: "[centeritem:4951] Ограничения пилонов"
	}

	OpenConfig: {
		Label: Открыть файл конфигурации
		Tooltip: Любая настройка появится в файле только после внесения изменений
	}

	TownNPCHome: {
		Label: "[centeritem:MusicBoxTownDay] Телепортировать поселенцев домой"
		Tooltip:
			'''
			Нажатие ПКМ по кнопке «Дом» телепортирует всех поселенцев домой
			При изменении дома поселенца, его сразу же телепортирует в новый дом
			'''
		HoverText: (<right>, чтобы телепортировать поселенцев домой)
	}

	NoLakeSizePenalty: {
		Label: "[centeritem:FishingPotion] Нет ограничений по размерам водоёма"
		Tooltip:
			'''
			Любой водоём будет считаться полным для рыбалки
			Это убирает снижение мастерства рыбалки из-за рыбалки в маленьких водоёмах
			Позволяет рыбачить даже в 2 блоках воды
			'''
	}

	InfiniteRedPotion: {
		Label: "[centeritem:RedPotion] Создание красного зелья"
		Tooltip:
			'''
			Если ваш мир использует зерно «Get fixed boi» или «For the worthy»,
			вы можете использовать все предметы для создания зелий, чтобы создать красное зелье
			Бесконечное красное зелье будет давать все свои возможные эффекты
			Однако, их нельзя складывать в сумку для зелий
			'''
		Condition: Включено «Создание красного зелья»
	}

	RedPotionEverywhere: {
		Label: "[centeritem:RedPotion] Безграничное красное зелье"
		Tooltip:
			'''
			Включает «Создание красного зелья» для всех миров,
			а не только для «Get fixed boi» и «For the worthy»
			'''
		Condition: Включено «Безграничное красное зелье»/{$Conditions.WorldForTheWorthy}
	}

	RedPotionRequirement: {
		Label: "[centeritem:RedPotion] Требования бесконечного красного зелья"
		Tooltip:
			'''
			Требует	«Создание красного зелья» для работы
			Определяет требуемый размер стака для бесконечного зелья только для красного зелья
			'''
	}

	LongerExpertDebuff: {
		Label: "[centeritem:DemonHeart] Длительность ослаблений в режиме эксперта"
		Tooltip:
			'''
			Переключает увеличенную длительность ослаблений в режиме эксперта и выше
			Если настройка выключена, будет использована длительность ослаблений классического режима
			'''
	}

	LightNotBlocked: {
		Label: "[centeritem:UltrabrightTorch] Блоки не блокируют свет"
		Tooltip:
			'''
			Определяет, блокируют ли блоки свет или нет
			Если настройка выключена, использует ванильное поведение света
			'''
	}

	BombsNotDamage: {
		Label: "[centeritem:TNTBarrel] Взрывы не наносят урона"
		Tooltip:
			'''
			Отключает урон от взрывчатки
			Влияет только на взрывчатку, разрушающую блоки. Не влияет на гранаты, не разрушающие блоки ракеты и др.
			'''
	}

	DisableNonPlayerBombsExplosions: {
		Label: "[centeritem:TNTBarrel] Взрывчатка не от игроков не ломают блоки"
		Tooltip: Взрывчатка, созданная не игроком, не ломает блоки
	}

	WorldFeaturePanel: {
		Label: "[centeritem:WorldGlobe] Панель особенностей мира"
		Tooltip:
			'''
			Открывается через панель управления
			Переключает праздники и особенности секретных зёрен
			'''
	}

	BedEverywhere: {
		Label: "[centeritem:Bed] Безграничное возрождение на кровати"
		Tooltip:
			'''
			Кровати могут быть использованы как точки возрождения при любых условиях,
			несмотря на требования для дома
			'''
	}

	MinimapMark: {
		Tooltip:
			'''
			Позволяет использовать «обнаружители», чтобы отмечать следующие структуры на карте:
			Эфир, подземелье, храм джунглей, парящие острова, пирамиды, бутоны Плантеры и святилища зачарованных мечей
			'''
		Label: "[centeritem:WorldGlobe] Метки для структур"
	}

	ModifyNPCHappiness: {
		Label: "[centeritem:LifeCrystal] Фиксированное счастье поселенцев"
		Tooltip: Фиксирует «счастье» поселенцев на определённом значении
	}

	NPCHappiness: {
		Label: "[centeritem:LifeCrystal] Множитель ценников поселенцев (%)"
		Tooltip:
			'''
			Чем меньше значение, тем «счастливее» поселенцев, тем дешевле они продают свои предметы и тем дороже они покупают ваши
			Поселенцы всегда продают пилоны, когда значение меньше или равно 90
			'''
	}

	NoSleepRestrictions: {
		Label: "[centeritem:Bed] Безусловный сон"
		Tooltip: Сон ускоряет время в любых условиях
	}

	BedTimeRate: {
		Label: "[centeritem:Bed] Скорость ускорения сна"
		Tooltip: Позволяет изменить скорость ускорения времени, когда игрок спит, по умолчанию — 5-кратное ускорение
	}

	BedOnlyOne: {
		Label: "[centeritem:Bed] Отоспаться за десятерых"
		Tooltip: В сетевой игре хватит одного игрока, чтобы ускорить время в мире
	}

	WandMaterialNoConsume: {
		Tooltip:
			'''
			Блоки и стены в стаках более 999 не будут тратиться при использовании жезлов пространства/технологий/архитектуры
			Предметы мебели не будут тратиться в стаках более 99
			'''
		Label: "[centeritem:ImproveGame/SpaceWand] Бесконечные ставящие жезлы"
	}

	DummyCustomAIStyleAllowed: {
		Tooltip:
			'''
			Когда включена, кто угодно на сервере сможет изменять поведение пугала на любое существо
			Т.к. пугала и манекены могут вызывать много лагов, рекомендуем дважды подумать, прежде чем включать данную настойку
			'''
		Label: "[centeritem:ImproveGame/Dummy] {$Mods.ImproveGame.UI.DummyConfiguration.DummyConfigLabel}"
	}

	QuestFishStack: {
		Label: "[centeritem:Clownfish] Складывающиеся рыбы заданий"
		Tooltip: Рыбы заданий рыбака могут складываться, а также их можно выловить и подобрать, даже когда эта рыба уже есть в вашем инвентаре
	}

	QuickRespawn: {
		Label: "[centeritem:3232] Ускоренное возрождение без боссов"
		Tooltip: Время возрождения уменьшено до 1,5 секунд, когда в мире нет боссов
	}

	AllOff: {
		Label: Экстренное выключение
		Tooltip: Восстанавливает (почти) все настройки до ванильных значений. Приятной игры в ванильную Terraria!
	}

	NoConditionTP: {
		Label: "[centeritem:WormholePotion] Безусловная телепортация в команде"
		Tooltip: Игроки могут телепортироваться к сокомандникам без зелий червоточины, даже если они у них есть
	}

	OpenFaq: {
		Tooltip:
			'''
			Рекомендуем посмотреть данную страницу в случае, если вы встретитесь
			с любыми проблемами. Данная страница включает в себя решения для следующих проблем:
			– Как скрыть бесконечные эффекты?
			– Как автоматически складывать деньги в копилку?
			– Как скрыть эффекты над головой персонажа?
			'''
		Label: Часто задаваемые вопросы
	}

	WeatherControl: {
		Label: "[centeritem:ImproveGame/WeatherBook] Контроль над погодой"
		Tooltip:
			'''
			Позволяет менять направление ветра, фазу луны, дождь,
			а также время после победы над Стеной плоти
			Становится доступным с помощью погодной книги, открывается через панель управления
			Доступность зависит от мира
			'''
	}

	AmmoChain: {
		Label: "[centeritem:ImproveGame/AmmoChainItem] Цепочка боеприпасов"
		Tooltip:
			'''
			Позволяет оружиям использовать боеприпасы в определённой последовательности
			Открывается через панель управления
			'''
	}

	SimpleVeinMining: {
		Label: "[centeritem:IronPickaxe] Простое копание жил"
		Tooltip:
			'''
			Простая функция копания жил руды. Пассивно работает при копании киркой
			Нет чёрного/белого списка, и не поддерживает какие-либо изменения
			Если вам нужны эти функции, рекомендуем использовать мод Ore Excavator или Basic Automated Mining
			Если один из этих двух модов включён, эта настройка будет отключена
			'''
		PopupTip: Копание жил руды можно отключить в конфигурациях Quality of Terraria
	}

	DisableVeinMiningPopup: {
		Label: "[centeritem:IronPickaxe] Отключить уведомление о копании жил"
		Tooltip: Отключает надоедливое уведомление раз и навсегда
	}

	QuickShimmer: {
		Label: "[centeritem:ImproveGame/ShellShipInBottle_Shimmered] Быстрое мерцание"
		Tooltip:
			'''
			Позволяет превращать предметы с помощью мерцания в инвентаре
			Становится доступным с помощью корабля в мерцающей бутылке, открывается через панель управления
			Доступность зависит от мира
			'''
	}

	PylonPlaceNoRestriction: {
		Label: "[centeritem:TeleportationPylonPurity] Неограниченные пилоны"
		Tooltip: Позволяет поставить сколько угодно пилонов где угодно
	}

	PylonTeleNoNear: {
		Label: "[centeritem:TeleportationPylonUnderground] Глобальная телепортация к пилонам"
		Tooltip: Позволяет телепортироваться к пилонам из любой точки мира
	}

	PylonTeleNoNPC: {
		Label: "[centeritem:TeleportationPylonHallow] Телепортация по пилонам без поселенцев"
		Tooltip: Позволяет телепортироваться к пилону, даже когда рядом с ним нет поселенцев
	}

	PylonTeleNoDanger: {
		Label: "[centeritem:TeleportationPylonJungle] Телепортация по пилонам, игнорирующая угрозы"
		Tooltip: Позволяет телепортироваться к пилону, даже когда жив босс/активно событие
	}

	PylonTeleNoBiome: {
		Label: "[centeritem:TeleportationPylonMushroom] Телепортация по пилонам, игнорирующая биомы"
		Tooltip: «Ежели я так сказал, то так тому и быть!»
	}
}

