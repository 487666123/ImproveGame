Keybinds: {
	HugeInventory: {
		DisplayName: 大背包
		Tip: 按下后打开大背包，也可以在总控面板中打开
	}

	BuffTracker: {
		DisplayName: 增益追踪器
		Tip: 设置快捷键后，点击增益图标不再会打开增益追踪器
	}

	GrabBagLoot: {
		DisplayName: 显示摸彩袋物品明细
		Tip: 对着一个摸彩袋（宝藏袋、宝匣等）按下此快捷键可查看其各物品掉率
	}

	HotbarSwitch: {
		DisplayName: 切换快捷栏
		Tip: 按下快捷键后，物品栏第一栏与第二栏的物品将会互换
	}

	AutoTrashKeybind: {
		DisplayName: 隐藏/显示自动垃圾桶
		Tip: 仅隐藏功能，并不会关闭，若想彻底关闭此功能可在“体系化功能”配置中调节
	}

	DiscordRodKeybind: {
		DisplayName: 传送法杖快捷键
		Tip: 按下后快捷使用物品栏中的传送法杖（混沌传送杖与调谐传送杖）
	}

	HomeKeybind: {
		DisplayName: 回程快捷键
		Tip:
			'''
			按下后快捷使用物品栏中的回程物品（优先级：无限返回药水>无限回忆药水>魔镜类物品）
			对于药水，只有开启了“无限续杯”且达到需求量才会被使用
			'''
	}

	OpenBagGUI: {
		DisplayName: 快速开袋
		Tip: 按下后打开快速开袋界面，也可以在总控面板中打开
	}

	MasterControl: {
		DisplayName: 总控
		Tip:
			'''
			按住（按住！）此快捷键以打开更好的体验快捷功能
			要使用快捷功能，您必须绑定该快捷键
			'''
	}

	ItemInteract: {
		DisplayName: 随身物品特殊交互快捷键
		Tip: 用于部分物品的快捷交互，如激活坐骑、打开猪猪存钱罐等
	}

	CopyItemName: {
		DisplayName: "[调试功能] 复制物品内部名"
		Tip: 当光标处有物品时，按下此快捷键将会复制其内部名
	}

	CopyItemName_Control: {
		DisplayName: "[调试功能] 复制物品内部名全称组合键"
		Tip: 按下此快捷键的同时按下 "{$Mods.ImproveGame.Keybinds.CopyItemName.DisplayName}" 将改为复制全称
	}

	QuickShimmerGUI: {
		// DisplayName: "{$Mods.ImproveGame.UI.QuickShimmer.Title}"
		Tip: 按下后打开快捷微光界面，也可以在总控面板中打开
	}

	ExtremeStorageSearch: {
		DisplayName: 在储存管理器中搜索
		Tip: 打开储存管理器界面时，将鼠标悬停于任意物品上并按下此快捷键以搜索物品
	}
}

