	CreateWandOn: 按下 {KeybindName} 以开启房屋材料面板
	CreateWandOff: 按下 {KeybindName} 以关闭房屋材料面板
	LiquidWandOn: 按下 {KeybindName} 以开启液体控制面板
	LiquidWandOff: 按下 {KeybindName} 以关闭液体控制面板
	PotionBagCurrent: 该药水袋内目前拥有下列药水 ({StoredCount}/200):
	PotionBagCurrentFull: 该药水袋内目前拥有下列药水 (已满!):
	PotionBagNone: 该药水袋未装有药水 (0/200)
	PotionBagAvailable: (生效中)
	PotionBagUnavailable: (未生效)
	PotionBagDisabled: (被禁用)
	BannerChestCurrent: 该旗帜箱内目前拥有下列旗帜 ({StoredCount}/500):
	BannerChestCurrentFull: 该旗帜箱内目前拥有下列旗帜 (已满!):
	BannerChestNone: 该旗帜箱未装有旗帜 (0/500)
	BannerChestUseless: 便携旗帜功能未开启，放入其中的旗帜不会有任何用处
	Tag.ShiftEnable: "[按住 [c/88CCEE:Shift] 键以了解更多信息]"

	TagDetailed: {
		OwnedInfineBuff: "[已获得无限 Buff 效果 {Count}/{Threshold}]"
		NotOwnedInfineBuff: "[未获得无限 Buff 效果 {Count}/{Threshold}]"
		RedPotion: "[红药水]"
		GardenGnome: "[花园侏儒]"
		Enabled: "[已启用]"
		Disabled: "[已禁用]"
		Hided: "[增益图标已隐藏]"
		NonHided: "[增益图标未隐藏]"
		CombinedBuff: "[存在可用的增益组合]"
		AutoCollect: "[自动存钱]"
		CreateWand: "[自定义样式]"
	}

	TagDetailedTip: {
		RedPotion:
			'''
			红药水扩展效果已应用，你将获得以下无尽增益:
			{$BuffName.ObsidianSkin}, {$BuffName.Regeneration}, {$BuffName.Swiftness}, {$BuffName.Ironskin}, {$BuffName.ManaRegeneration}, {$BuffName.MagicPower}, {$BuffName.Featherfall}, {$BuffName.Spelunker}, {$BuffName.Archery}, {$BuffName.Heartreach}
			{$BuffName.Hunter}, {$BuffName.Endurance}, {$BuffName.Lifeforce}, {$BuffName.Inferno}, {$BuffName.Mining}, {$BuffName.Rage}, {$BuffName.Wrath}, {$BuffName.Dangersense}
			'''
		GardenGnome:
			'''
			花园侏儒的幸运加成已应用
			你无法开关此效果，因为这不是一个增益
			'''
		Enabled:
			'''
			物品增益 [c/88CCEE:[{BuffName}][c/88CCEE:]] 已自动应用
			如果你想要单独禁用该物品的增益
			请对着该物品按下 {KeybindName} 或左键点击增益图标
			开启增益追踪器，以控制增益是否启用
			'''
		Disabled:
			'''
			物品增益 [c/88CCEE:[{BuffName}][c/88CCEE:]] 已因设置被禁用
			对着该物品按下 {KeybindName} 或左键点击增益图标
			开启增益追踪器，以控制增益是否启用
			'''
		Hided:
			'''
			增益图标已从Buff栏中隐藏
			如果想要显示请在模组[c/CC88AA:个人配置]中修改
			'''
		NonHided:
			'''
			如果想要隐藏无限续杯增益图标
			请在模组[c/CC88AA:个人配置]中修改
			'''
		AutoCollect:
			'''
			你必须先在存钱罐中放入任意钱币才能使用此功能
			钱币会自动存入存钱罐
			此功能可在物品栏最左侧工具栏中开关
			商人的生成条件会同时计算存钱罐内的钱币
			'''
		CombinedBuff.Battle:
			'''
			[c/88CCEE:增益组合: ][i:CalmingPotion][i:Sunflower][i:PeaceCandle][i:WaterCandle][i:BattlePotion]
			当你同时拥有以上无限增益物品时
			在增益追踪器右侧会显示一个生物生成
			速度滑块，允许你将生物生成速度调至
			x{MinSpawn}-x{MaxSpawn}
			'''
		CreateWand:
			'''
			在管理器界面可以用数据图或者构造魔杖结构导入建筑样式
			在 [c/88CCEE:"文档/My Games/Terraria/tModLoader]
			[c/88CCEE:/Mods/ImproveGame/CreateWand"]
			目录下的图片会自动导入

			数据图中
			B通道为FF表示有墙壁，00表示没有墙壁
			A通道为FF表示朝向左，7F表示朝向右
			RG通道代表物块如下表：
			| 颜色  |    Hex   |   代表的物块   |
			| ------- | ---------- | -------------------- |
			|   [c/000000:■]   |   0000  |        留空        |
			|   [c/003F00:■]   |   003F  |       实心块      |
			|   [c/007F00:■]   |   007F  |        平台        |
			|   [c/00BF00:■]   |   00BF  |       工作台      |
			|   [c/00FF00:■]   |   00FF  |        桌子        |
			|   [c/3F0000:■]   |   3F00  |        椅子        |
			|   [c/3F3F00:■]   |   3F3F  |         门          |
			|   [c/3F7F00:■]   |   3F7F  |        箱子        |
			|   [c/3FBF00:■]   |   3FBF  |         床          |
			|   [c/3FFF00:■]   |   3FFF  |        书架        |
			|   [c/7F0000:■]   |   7F00  |        浴缸        |
			|   [c/7F3F00:■]   |   7F3F  |        烛台        |
			|   [c/7F7F00:■]   |   7F7F  |        蜡烛        |
			|   [c/7FBF00:■]   |   7FBF  |        吊灯        |
			|   [c/7FFF00:■]   |   7FFF  |         钟          |
			|   [c/BF0000:■]   |   BF00  |       梳妆台      |
			|   [c/BF3F00:■]   |   BF3F  |         灯          |
			|   [c/BF7F00:■]   |   BF7F  |        灯笼        |
			|   [c/BFBF00:■]   |   BFBF  |        钢琴        |
			|   [c/BFFF00:■]   |   BFFF  |        水槽        |
			|   [c/FF0000:■]   |   FF00  |        沙发        |
			|   [c/FF3F00:■]   |   FF3F  |        厕所        |
			|   [c/FF7F00:■]   |   FF7F  |        火把        |
			|   [c/FFBF00:■]   |   FFBF  |        篝火        |
			'''
	}
}

ConstructGUI: {
	Structure: 建筑结构
	# 这个是存储后的文件名
	SavedAs: "结构已存储为 "
	# 后接文件名
	SaveMode: 存储模式
	LoadMode: 放置模式
	ExplodeAndPlace: 爆破并放置
	PlaceOnly: 仅放置
	Path: "文件路径: "
	# 执行操作时，显示在玩家脚下
	Saving: 保存中
	Saved: 已保存
	Placing: 放置中
	Placed: 已放置
	Stopped: 已终止

	RenameTip: {
		Exists: 已经存在一个相同名称的文件
		TooLong: 名称不能超过40个字符
	}

	FileInfo: {
		Title: 文件信息
		Name: 文件名: {Name}
		Time: 保存时间: {Time}
		Version: 版本号: {Version}
		Size: 结构尺寸: {Size}

		ModMissing: {
			// Count: "2"
			1: 该结构包含未被加载的模组的物块或背景墙
			2: 放置有可能发生错误
		}

		LoadError: 文件不合法或不是结构文件
	}

	MaterialInfo: {
		Title: 材料明细
		Tip: 放置在大背包中的材料也可以使用
		Stored: 已有: {Stack}
		Requirement: 需求: {Stack}
	}

	Preview: {
		Title: 结构预览
		CenterSet: 点击以将其设置为放置中心点
	}

	Tutorial: {
		Button: 功能介绍

		AlphaTest: {
			Count: "2"
			1: 如果遇到Bug请报告给开发者
			2: 对于模组物块与背景墙不保证支持，不应视作Bug
			// 3: and should not be considered a bug
		}

		Save: {
			// Title: "{$Mods.ImproveGame.ConstructGUI.SaveMode}"
			Text:
				'''
				面板上方左侧的第三个按钮可以切换模式为放置或存储

				在存储模式下，你可以左键使用构造法杖以框选结构，并将结构以文件形式存储到你的电脑上。以便在不同的世界以及服务器中放置结构。
				    
				下图展示了如何框选并保存结构:
				'''
		}

		Place: {
			// Title: "{$Mods.ImproveGame.ConstructGUI.LoadMode}"
			Text:
				'''
				在放置模式下，你需要在主界面选择一个结构，如果结构名称显示为黄色，则表明当前选择了此结构。
				    
				如果在你的物品栏与大背包内有足够的材料，左键使用即可将结构放置到世界上，否则结构可能会残缺一部分。
				某些物块的朝向可能会出现问题，属于正常现象
				    
				此处是一个放置结构的例子:
				'''
		}

		Explode: {
			Title: 爆破模式
			Text: 如果你选择了“爆破并放置”，那么在放置结构前，相应区域的物块将会被爆破，以给结构腾出足够的空间。
		}

		Panel: {
			Title: 结构列表
			Text:
				'''
				在UI主界面显示了当前存储于你的电脑上的结构列表，每个结构单元包含了文件名称、路径信息。
				    
				如果你在Windows系统上不小心删除了某个结构，你可以在回收站还原

				点击右方的“{$tModLoader.ModsMoreInfo}”按钮即可查看材料明细与结构预览，同时可以在预览界面选择结构放置时的中心点。
				'''
		}

		Materials: {
			// Title: "{$Mods.ImproveGame.ConstructGUI.MaterialInfo.Title}"
			Text: 在材料明细区域中可以查看各种材料的需求量以及当前存储于你的物品栏和大背包的数量，以便你准备相应的材料
		}

		Preview: {
			// Title: "{$Mods.ImproveGame.ConstructGUI.Preview.Title}"
			Text: 结构预览区域可供查看结构，并调节结构的放置中心点，即放置结构时鼠标指针所指向的物块。黄框标示的物块即为放置中心点
		}
	}
}

