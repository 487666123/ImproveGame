	BuffTracker: {
		DisplayName: Трекер баффов
		Tip: Если назначена клавиша, нажатие по иконке баффа больше не будет открывать трекер
	}

	GrabBagLoot: {
		DisplayName: Предметы в мешке
		Tip: Показывает предметы и шанс их выпадения из мешка под вашим курсором
	}

	HotbarSwitch: {
		DisplayName: Сменить панель быстрого доступа
		Tip: Меняет предметы в панели быстрого доступа со второй строкой вашего инвентаря
	}

	AutoTrashKeybind: {
		DisplayName: Скрыть/Показать корзину для авто-выбрасывания
		Tip: Только прячет слоты, не отключает функцию. Чтобы отключить её, используйте конфигурацию «Другое».
	}

	DiscordRodKeybind: {
		DisplayName: Использовать телепортирующий жезл
		Tip: Использует жезл раздора/гармонии из вашего инвентаря
	}

	HomeKeybind: {
		DisplayName: Использовать предмет возврата
		Tip:
			'''
			Использует предмет, возвращающий игрока на спавн ([centeritem:4870] > [centeritem:2350] > [centeritem:50]/[centeritem:3199])
			Зелья могут быть использованы только если включена настройка «Бесконечные зелья» и в инвентаре есть нужное кол-во зелий
			'''
	}

	OpenBagGUI: {
		DisplayName: Открывашка для мешков
		Tip: Открывает меню открывашки для мешков; также можно открыть через панель управления
	}

	MasterControl: {
		DisplayName: Панель управления
		Tip:
			'''
			Открывает панель управления мода Quality of Terraria
			Вы ДОЛЖНЫ назначить клавишу, чтобы получить доступ к панели
			'''
	}

	ItemInteract: {
		DisplayName: Особые взаимодействия
		Tip: Взаимодействия с предметами, напр. наездными питомцами или свиньёй-копилкой
	}

	CopyItemName: {
		DisplayName: "[DEBUG] Скопировать внутреннее имя предмета"
		Tip: Нажмите эту клавишу, наведя курсор на предмет, чтобы скопировать внутреннее имя последнего
	}

	CopyItemName_Control: {
		DisplayName: "[DEBUG] Скопировать полное внутреннее имя предмета"
		Tip: Нажмите эту клавишу и «{$Mods.ImproveGame.Keybinds.CopyItemName.DisplayName}», чтобы скопировать полное внутреннее имя предмета
	}

	QuickShimmerGUI: {
		DisplayName: "{$Mods.ImproveGame.UI.QuickShimmer.Title}"
		Tip: Открывает интерфейс быстрого мерцания; также можно открыть через панель управления
	}

	ExtremeStorageSearch: {
		DisplayName: Поиск в панели управления хранилищем
		Tip: Когда панель управления хранилищем открыта, наведите на любой предмет и нажмите на эту клавину, чтобы начать поиск этого предмета.
	}
}

