	BannerChestUseless: Настройка «Переносные знамёна» отключена, знамёна внутри не будут работать
	Tag.ShiftEnable: "[Удерживайте [c/88CCEE:Shift], чтобы узнать больше]"

	TagDetailed: {
		OwnedInfineBuff: "[Бесконечный бафф получен {Count}/{Threshold}]"
		NotOwnedInfineBuff: "[Бесконечный бафф можно {Count}/{Threshold}]"
		RedPotion: "[Красное зелье]"
		GardenGnome: "[Садовый гном]"
		Enabled: "[Включён]"
		Disabled: "[Выключен]"
		Hided: "[Иконки баффов скрыты]"
		NonHided: "[Иконки баффов показаны]"
		CombinedBuff: "[Доступна комбинация баффов]"
		AutoCollect: "[Авто-сбор]"
		// CreateWand: "[Customize]"
	}

	TagDetailedTip: {
		RedPotion:
			'''
			Включено «Бесконечное красное зелье», даёт следующие бесконечные баффы:
			{$BuffName.ObsidianSkin}, {$BuffName.Regeneration}, {$BuffName.Swiftness}, {$BuffName.Ironskin},
			{$BuffName.ManaRegeneration}, {$BuffName.MagicPower}, {$BuffName.Featherfall}, {$BuffName.Spelunker},
			{$BuffName.Archery}, {$BuffName.Heartreach}, {$BuffName.Hunter}, {$BuffName.Endurance}, {$BuffName.Lifeforce}, {$BuffName.Inferno},
			{$BuffName.Mining}, {$BuffName.Rage}, {$BuffName.Wrath}, {$BuffName.Dangersense}.
			'''
		GardenGnome:
			'''
			Вы получаете бонус к удаче от садового гнома
			Вы не можете отключить данный бонус, т.к. это не «бафф»
			'''
		Enabled:
			'''
			Бафф [c/88CCEE:[{BuffName}][c/88CCEE:]] уже активен.
			Если вы хотите отключить данный бафф,
			нажмите {KeybindName}, наведя курсор на предмет, либо ЛКМ по иконке баффа,
			чтобы открыть трекер, и отключите бафф.
			'''
		Disabled:
			'''
			Бафф [c/88CCEE:[{BuffName}][c/88CCEE:]] неактивен
			в связи с соотв. настройками.
			Нажмите {KeybindName}, наведя курсор на предмет, либо ЛКМ по иконке баффа,
			чтобы открыть трекер, и включите бафф.
			'''
		Hided:
			'''
			Иконки баффов были скрыты. Чтобы они показывались,
			настройте это в [c/CC88AA:персональных настройках].
			'''
		NonHided:
			'''
			Измените [c/CC88AA:персональные настройки] мода,
			если хотите скрыть иконки баффов.
			'''
		AutoCollect:
			'''
			Чтобы эта функция работала,
			в вашей свинье-копилке должна
			быть хотя бы одна монета.
			Ваши монеты будут автоматически
			перемещаться в свинью-копилку.
			Это можно переключить в левой верхней
			части инвентаря.
			Монеты, нужные для Торговца,
			будут считаться и из свиньи-копилки.
			'''
		CombinedBuff.Battle:
			'''
			[c/88CCEE:Комбинация баффов: ][i:CalmingPotion][i:Sunflower][i:PeaceCandle][i:WaterCandle][i:BattlePotion]
			Когда у вас есть бесконечные баффы предметов
			выше, справа от трекера баффов появится
			слайдер скорости появления мобов, позволяя
			увеличивать множитель скорости от x0 до x{MaxSpawn}
			'''
		/* CreateWand:
			'''
			You can import Building style by Datamap or Structure file of ConstructWand in the CreateWand Controller
			Files in [c/88CCEE:"Document/My Games/Terraria/tModLoader]
			[c/88CCEE:/Mods/ImproveGame/CreateWand"]
			will import automatically

			In Datamap:
			B channel of FF means there's wall, 00 means no wall.
			A channel of FF means Left Direction, 7F means Right Direction
			RG channel's tile table as followed:
			| Color |    Hex   |        Tile        |
			| ------- | ---------- | ------------------- |
			|   [c/000000:■]   |   0000  |      Empty       |
			|   [c/003F00:■]   |   003F  |     SolidTile     |
			|   [c/007F00:■]   |   007F  |     Platform     |
			|   [c/00BF00:■]   |   00BF  |    Workbench  |
			|   [c/00FF00:■]   |   00FF  |      Table        |
			|   [c/3F0000:■]   |   3F00  |      Chair        |
			|   [c/3F3F00:■]   |   3F3F  |       Door       |
			|   [c/3F7F00:■]   |   3F7F  |      Chest       |
			|   [c/3FBF00:■]   |   3FBF  |       Bed         |
			|   [c/3FFF00:■]   |   3FFF  |    Bookcase    |
			|   [c/7F0000:■]   |   7F00  |     Bathtub      |
			|   [c/7F3F00:■]   |   7F3F  |   Candelabra   |
			|   [c/7F7F00:■]   |   7F7F  |     Candle       |
			|   [c/7FBF00:■]   |   7FBF  |    Chandler     |
			|   [c/7FFF00:■]   |   7FFF  |      Clock        |
			|   [c/BF0000:■]   |   BF00  |     Dresser      |
			|   [c/BF3F00:■]   |   BF3F  |      Lamp        |
			|   [c/BF7F00:■]   |   BF7F  |     Lantern      |
			|   [c/BFBF00:■]   |   BFBF  |      Piano       |
			|   [c/BFFF00:■]   |   BFFF  |      Sink         |
			|   [c/FF0000:■]   |   FF00  |      Sofa         |
			|   [c/FF3F00:■]   |   FF3F  |      Toilet        |
			|   [c/FF7F00:■]   |   FF7F  |      Torch       |
			|   [c/FFBF00:■]   |   FFBF  |    Campfire     |
			''' */
	}
}

ConstructGUI: {
	Structure: Структура QoT
	# 这个是存储后的文件名
	SavedAs: "Структура сохранена как "
	# 后接文件名
	SaveMode: Режим пипетки
	LoadMode: Режим размещения
	ExplodeAndPlace: Уничтожить и поставить
	PlaceOnly: Поставить
	Path: "Путь к файлу: "
	# 执行操作时，显示在玩家脚下
	Saving: Сохраняем
	Saved: Сохранено
	Placing: Размещаем
	Placed: Размещено
	Stopped: Приостановлено

	RenameTip: {
		Exists: Файл с таким именем уже существует
		TooLong: Имя файла не должно превышать 40 символов
	}

	FileInfo: {
		Title: Информация о файле
		Name: Имя файла: {Name}
		Time: Дата сохранения: {Time}
		Version: Версия: {Version}
		Size: Размер структуры: {Size}

		ModMissing: {
			Count: "2"
			1: Данная структура содержит блоки и стены из незагруженного мода
			2: При размещении могут возникнуть ошибки
		}

		LoadError: Файл некорректен или не является файлом структуры
	}

	MaterialInfo: {
		Title: Материалы
		Tip: Материалы из большого рюкзака также используются
		Stored: Есть: {Stack}
		Requirement: Нужно: {Stack}
	}

	Preview: {
		Title: Предпросмотр структур
		CenterSet: ЛКМ, чтобы указать центр размещения
	}

	Tutorial: {
		Button: Инструкция

		AlphaTest: {
			Count: "3"
			1: Сообщайте о багах на странице мода в Мастерской Steam
			2: Поддержка блоков и стен из других модов не гарантирована
			3: и не будет считаться за баги
		}

		Save: {
			Title: "{$Mods.ImproveGame.ConstructGUI.SaveMode}"
			Text:
				'''
				Третья кнопка в левой верхней части панели переключает между режимами пипетки и размещения

				В режиме пипетки, удерживайте ЛКМ, чтобы выбрать структуру и сохранить её
				на своём компьютере как файл, чтобы размещать их в других мирах и серверах
				    
				Изображение снизу показывает, как выделять и сохранять структуры:
				'''
		}

		Place: {
			Title: "{$Mods.ImproveGame.ConstructGUI.LoadMode}"
			Text:
				'''
				В режиме размещения, вам нужно выбрать структуру на главной панели. Выбранная структура будет отмечена жёлтым
				    
				Если в вашем инвентаре или большом рюкзаке достаточно материалов, ЛКМ поставит структуру
				Ориентация некоторых блоков может быть некорректна
				    
				Пример поставленной структуре: 
				'''
		}

		Explode: {
			Title: Уничтожить и поставить
			Text: Если выбран режим «Уничтожить и поставить», территория для структуры будет очищена, чтобы предоставить достаточное место
		}

		Panel: {
			Title: Лист структур
			Text:
				'''
				Главная панель показывает список файлов структур на вашем компьютере, включая имя и путь файла
				    
				Если вы случайно удалили структуру на системе Windows, вы можете восстановить его из Корзины

				Нажмите кнопку «{$tModLoader.ModsMoreInfo}» в правой стороне, чтобы посмотреть детали и предпросмотр. Центр размещения структуры можно изменить на предпросмотре
				'''
		}

		Materials: {
			Title: "{$Mods.ImproveGame.ConstructGUI.MaterialInfo.Title}"
			Text: Вы можете посмотреть нужные и имеющиеся материалы под заголовком «Материалы»
		}

		Preview: {
			Title: "{$Mods.ImproveGame.ConstructGUI.Preview.Title}"
			Text: Предпросмотр структуры также показывает центр размещения (жёлтый 'блок'). Именно с этой точки будет ставиться структура.
		}
	}
}

