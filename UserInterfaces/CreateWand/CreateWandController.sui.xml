<?xml version="1.0" encoding="utf-8"?>
<!-- Class 填写对应类名 -->
<Body xmlns:s="https://github.com/487666123/SilkyUIFramework"
	  xmlns:b="https://github.com/487666123/SilkyUIFramework/Binding"
	  xmlns:prop="https://github.com/487666123/SilkyUIFramework/Properties"
	  s:Class="ImproveGame.UserInterfaces.CreateWand.CreateWandController"
      Enabled="false" EnableBlur="true" Width="375px" Height="300px"
      Border="0" BorderColor="#00000000" BackgroundColor="#00000000"
      Gap="0" Left="50#" Top="50#">
	<ElementGroup s:Name="MainContainer" Border="2" BorderRadius="8"
                  Width="100%" Height="100%"
                  FlexDirection="Column" CrossAlignment="Stretch">
		<DraggableView s:Name="Header" FitWidth="true" Height="36px" Gap="8"
                       Padding="8 0" FlexDirection="Row" MainAlignment="Start" CrossAlignment="Center">
			<!-- Title -->
			<TextView s:Name="Title" TextScale="0.45" FlexGrow="1" DisableMouseInteraction="true"/>
			
			<CWImageButton s:Name="ImportButton" b:Command="RegisterFromDatamapCommand" />
			<CWImageButton s:Name="FolderButton" b:Command="OpenFolderCommand"/>
			<CWImageButton s:Name="CloseButton" />
		</DraggableView>
		<HR BackgroundColor="rgba(0,0,0,0.75)"/>
		<ElementGroup Width="100%" Height="100%" FlexDirection="Column" FlexShrink="1"
                      CrossAlignment="Stretch" Padding="8">
			<!-- 根据 ItemSlot 计算的大小，没有 Grid 之前只能先这样 -->
			<ElementGroup Width="100%" Height="100%">
				<!-- 物品栏 -->
				<ScrollView s:Name="ItemSlot_Container" Width="100%" Height="100%" Orientation="Vertical">
					<prop:Mask Width="100%" Height="100%" />
					<prop:Container LayoutType="Grid" GridDirection="Row" />
				</ScrollView>
				<!-- 建筑数据表 -->
				<ElementGroup s:Name="BuildingDataListPanel" Invalid="true" Width="100%" Height="100%" FlexDirection="Column">
					<DataSourceScrollView s:Name="BuildingDataList" Width="100%" FlexGrow="1" FlexShrink="1" Height="100%" b:ItemSource="BuildingDataList">
						<prop:Mask Width="100%" Height="100%" />
						<prop:Container Width="100%" FlexWrap="true" FitHeight="true" FlexDirection="Row" MainAlignment="Start" />
					</DataSourceScrollView>
				</ElementGroup>
				<!-- 结构文件表 -->
				<DataSourceScrollView s:Name="StructureFileList" Width="100%" FlexGrow="1" FlexShrink="1" Height="100%" Invalid="true" b:ItemSource="QotStructureList" >
					<prop:Mask Width="100%" Height="100%" />
					<prop:Container Width="100%" FitHeight="true" FlexDirection="Row" MainAlignment="Start"/>
				</DataSourceScrollView>
			</ElementGroup>
		</ElementGroup>
		<HR BackgroundColor="rgba(0,0,0,0.75)"/>
		<!-- 导航栏 -->
		<ElementGroup s:Name="NavBar" Height="36px" FlexDirection="Row" CrossAlignment="Stretch" BackgroundColor="rgba(0,0,0,0.25)">

			<s:Style s:Name="ButtonContainer" s:Target="SilkyUIFramework.Elements.UIElementGroup"
					 Padding="4" FlexGrow="1" FlexDirection="Row" CrossAlignment="Stretch" />
			
			<s:Style s:Name="Button" s:Target="SilkyUIFramework.Elements.UITextView"
					 BorderRadius="4" FlexGrow="1" TextScale="0.8" TextAlign="0.5"/>

			<ElementGroup s:Style="ButtonContainer">
				<TextView s:Name="MaterialButton" s:Style="Button" />
			</ElementGroup>

			<VR BackgroundColor="rgba(0,0,0,0.75)"/>

			<ElementGroup s:Style="ButtonContainer">
				<TextView s:Name="BuildingDataListButton" s:Style="Button" />
			</ElementGroup>

			<VR BackgroundColor="rgba(0,0,0,0.75)"/>

			<ElementGroup s:Style="ButtonContainer">
				<TextView s:Name="StructDataListButton" s:Style="Button" />
			</ElementGroup>

		</ElementGroup>
	</ElementGroup>
</Body>